   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def square(x):\n",
    "    return x**2\n",
    "\n",
    "def sine(x):\n",
    "    return np.sin(x)\n",
    "\n",
    "def linear(x):\n",
    "    return 2*x +1\n",
    "\n",
    "x = np.linspace(0,100,10)\n",
    "y = linear(sine(square(1231)))\n",
    "plt.show()\n",
    "print(y,\"---\")"
   ]
